3. RAM (Read/Write Memory)

module ram(
    input clk,
    input we,
    input [1:0] addr,
    input [3:0] data_in,
    output reg [3:0] data_out
);

reg [3:0] memory [3:0];

always @(posedge clk) begin
    if (we)
        memory[addr] <= data_in;
    else
        data_out <= memory[addr];
end

endmodule

module tb_ram;

  reg clk;
  reg we;
  reg [1:0] addr;
  reg [3:0] data_in;
  wire [3:0] data_out;

  ram uut (
      .clk(clk),
      .we(we),
      .addr(addr),
      .data_in(data_in),
      .data_out(data_out)
  );

  always #5 clk = ~clk;

  initial begin
      $dumpfile("dump.vcd");
      $dumpvars(0, tb_ram);

      clk = 0;
      we = 0;
      addr = 2'b00;
      data_in = 4'b0000;

      #10 we = 1; addr = 2'b10; data_in = 4'b0111;
      #10 we = 1; addr = 2'b11; data_in = 4'b1001;
      #10 we = 0; addr = 2'b10;
      #10 we = 0; addr = 2'b11;

      #20 $finish;
  end

endmodule
